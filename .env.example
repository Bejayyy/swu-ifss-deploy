# Copy to .env and fill with your Firebase project values (Console → Project settings → Your apps).
# Restart `npm run dev` after changing this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Developer account (hardcoded login — change these to set your developer credentials)
VITE_DEV_EMAIL=developer@swu-ifss.com
VITE_DEV_PASSWORD=dev123456
